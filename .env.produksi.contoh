# Salin jadi .env di folder backend VPS:  cp env.produksi.contoh .env
# Lalu ganti SEMUA nilai "GANTI_...". Jangan commit .env ke Git.

APP_ENV=production
SEED_DEMO=false
MEDCREDIX_PORT=8080

# Subdomain aplikasi (huruf kecil semua)
DOMAIN=medcredix.spkd.ac.id
CORS_ORIGIN=https://medcredix.spkd.ac.id

# Database (container db). Sandi minimal 16 karakter.
DB_USER=medcredix
DB_PASSWORD=GANTI_sandi_db
DB_NAME=medcredix

# Buat dengan: openssl rand -base64 48
JWT_SECRET=GANTI_jwt_secret
# Kunci enkripsi berkas unggahan, buat dengan: openssl rand -base64 32
# SIMPAN DI TEMPAT AMAN DI LUAR SERVER. Hilang = semua dokumen tidak bisa dibuka.
FILE_ENCRYPTION_KEY=GANTI_kunci_berkas

SIMRS_FHIR_BASE_URL=
SIMRS_FHIR_TOKEN=
